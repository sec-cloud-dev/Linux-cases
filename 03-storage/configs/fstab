# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/sda2 during curtin installation
/dev/disk/by-uuid/d3228ddf-6b7b-464c-8099-e561f4bbe2f9 / ext4 defaults 0 1
UUID=26436d3b-8568-45c4-a8d3-8837ce40c09a /var/lib/postgresql xfs noatime,nosuid,nodev 0 0
UUID=90846405-9873-465e-8867-83d6e6372df1 /srv/scanner ext4 noatime,nosuid,nodev,noexec 0 2
UUID=37f9901a-fb7b-467d-876b-f59728b732f1 /backup ext4 noatime,nosuid,nodev,noexec,nofail 0 2
tmpfs /tmp tmpfs size=512M,mode=1777,nosuid,nodev 0 0
